# Copy to .env.local for local use. Never commit .env.local.

# The Ops Agent's /api/agent endpoint is off unless this is exactly "true".
# Leave it unset on any public deployment.
AGENT_LIVE_ENABLED=

# Which model answers. "scripted" is the built-in stand-in used by tests and the
# local demo. "openai" uses OpenAI Chat Completions and needs the two below.
AGENT_MODEL_PROVIDER=

# Only for AGENT_MODEL_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
# A model that supports tool calling through Chat Completions.
AGENT_MODEL=
